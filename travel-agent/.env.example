APP_NAME=travel-agent
APP_ENV=local
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
HMDP_BASE_URL=http://127.0.0.1:8085
HMDP_TIMEOUT=5.0
LLM_PROVIDER=fake
LLM_MODEL=fake-local
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT=30.0
LLM_MAX_ATTEMPTS=3
AMAP_API_KEY=
AMAP_TIMEOUT=8
MEMORY_DB_PATH=data/travel-memory.sqlite3
MEMORY_RETENTION_DAYS=90
TRAVEL_REQUESTS_PER_MINUTE=20

# sqlite is local development only; MySQL needs the separate database initialized first.
MEMORY_BACKEND=sqlite
MEMORY_MYSQL_HOST=127.0.0.1
MEMORY_MYSQL_PORT=3306
MEMORY_MYSQL_DATABASE=travel_agent
MEMORY_MYSQL_USER=
MEMORY_MYSQL_PASSWORD=
# Maximum simultaneous connections per Python worker (connections close after each transaction).
MEMORY_MYSQL_POOL_SIZE=5
# Optional CA certificate for verified MySQL TLS
MEMORY_MYSQL_SSL_CA=
